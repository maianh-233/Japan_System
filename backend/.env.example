# ============================================================================
# Cấu hình môi trường local — COPY file này thành `.env` (cùng thư mục) rồi sửa nếu cần.
#   cp .env.example .env
# File `.env` KHÔNG được commit (đã có trong .gitignore).
#
# Ai đọc file này:
#   - docker compose  (deploy/docker-compose.yml, qua --env-file .env)
#   - API .NET        (tự đọc khi chạy, xem src/Host/JPCenter.Api/DotEnv.cs)
#     Tên biến có "__" = mục con trong appsettings, vd Jwt__Issuer ⇔ "Jwt": { "Issuer" }.
# ============================================================================

# ---------- PostgreSQL (container Docker) ----------
POSTGRES_DB=jpcenter
POSTGRES_USER=jpcenter
POSTGRES_PASSWORD=jpcenter_dev_password
# 5433 để không đụng PostgreSQL cài sẵn trên máy (thường chiếm 5432)
POSTGRES_PORT=5433

# Chuỗi kết nối API dùng — phải khớp 4 giá trị trên
ConnectionStrings__Database=Host=localhost;Port=5433;Database=jpcenter;Username=jpcenter;Password=jpcenter_dev_password

# ---------- API ----------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
# Frontend (Vite) được phép gọi API — nhiều domain cách nhau dấu phẩy
Cors__AllowedOrigins=http://localhost:5173

# ---------- JWT ----------
Jwt__Issuer=jpcenter-api
Jwt__Audience=jpcenter-web
# Khóa ký access token — TỐI THIỂU 32 ký tự ngẫu nhiên. Đổi khi lên môi trường thật.
Jwt__SigningKey=dev-only-change-me-0123456789-abcdefghijklmnopqrstuvwxyz
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# ---------- Dữ liệu mẫu ----------
# Development: tự chạy migration + nạp dữ liệu mẫu khi DB còn trống (chỉ nạp 1 lần, không xóa)
Seed__Enabled=true
# Mật khẩu cho MỌI tài khoản mẫu (Super Admin: admin@jpcenter.vn)
Seed__DefaultPassword=Jpcenter@123

# ---------- Email (Mailpit — hộp thư giả, xem tại http://localhost:8025) ----------
Email__Host=localhost
Email__Port=1025
Email__From=no-reply@jpcenter.vn
Email__FromName=JP Center

# ---------- Log (Seq — xem tại http://localhost:5341) ----------
Seq__Url=http://localhost:5341
