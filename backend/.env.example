# ============================================================================
# Cấu hình môi trường local — COPY file này thành `.env` (cùng thư mục) rồi sửa nếu cần.
#   cp .env.example .env
# File `.env` KHÔNG được commit (đã có trong .gitignore).
#
# Ai đọc file này:
#   - docker compose  (deploy/docker-compose.yml, qua --env-file .env)
#   - API .NET        (tự đọc khi chạy, xem src/Host/JPCenter.Api/DotEnv.cs)
#     Tên biến có "__" = mục con trong appsettings, vd Jwt__Issuer ⇔ "Jwt": { "Issuer" }.
# ============================================================================

# ---------- PostgreSQL (container Docker) ----------
POSTGRES_DB=jpcenter
POSTGRES_USER=jpcenter
POSTGRES_PASSWORD=jpcenter_dev_password
# 5433 để không đụng PostgreSQL cài sẵn trên máy (thường chiếm 5432)
POSTGRES_PORT=5433

# Chuỗi kết nối API dùng — phải khớp 4 giá trị trên
ConnectionStrings__Database=Host=localhost;Port=5433;Database=jpcenter;Username=jpcenter;Password=jpcenter_dev_password

# ---------- API ----------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
# Frontend (Vite) được phép gọi API — nhiều domain cách nhau dấu phẩy
Cors__AllowedOrigins=http://localhost:5173
# Địa chỉ frontend — dùng cho link trong email (kích hoạt tài khoản, đăng nhập)
App__FrontendUrl=http://localhost:5173

# ---------- JWT ----------
Jwt__Issuer=jpcenter-api
Jwt__Audience=jpcenter-web
# Khóa ký access token — TỐI THIỂU 32 ký tự ngẫu nhiên. Đổi khi lên môi trường thật.
Jwt__SigningKey=dev-only-change-me-0123456789-abcdefghijklmnopqrstuvwxyz
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# ---------- Dữ liệu mẫu ----------
# Development: tự chạy migration + nạp dữ liệu mẫu khi DB còn trống (chỉ nạp 1 lần, không xóa)
Seed__Enabled=true
# Mật khẩu cho MỌI tài khoản mẫu (Super Admin: admin@jpcenter.vn)
Seed__DefaultPassword=Jpcenter@123

# ---------- Email (Mailpit — hộp thư giả, xem tại http://localhost:8025) ----------
Email__Host=localhost
Email__Port=1025
Email__From=no-reply@jpcenter.vn
Email__FromName=JP Center
# Máy chủ thật (vd Gmail / SES): bật SSL + tài khoản SMTP
# Email__Port=587
# Email__EnableSsl=true
# Email__Username=
# Email__Password=
# Người nhận bấm "Trả lời" → về hộp thư này (mặc định = App__SupportEmail)
# Email__ReplyTo=hotro@jpcenter.vn

# Thông tin in ở chân mọi email (mặc định trong appsettings.json)
# App__CenterName=JP Center
# App__Tagline=Trung tâm Nhật ngữ
# App__Hotline=1900 0000
# App__SupportEmail=hotro@jpcenter.vn
# App__Address=Hà Nội · TP. Hồ Chí Minh · Đà Nẵng

# ---------- Lưu file (ADR 0003) — kho S3-compatible ----------
# Local: SeaweedFS trong docker compose (khóa tùy ý, tự tạo bucket)
Storage__ServiceUrl=http://localhost:8333
Storage__Bucket=jpcenter
Storage__AccessKey=local
Storage__SecretKey=local
Storage__CreateBucket=true
# Thời hạn link xem / tải file (phút)
Storage__LinkMinutes=15
# Môi trường thật — Cloudflare R2 (miễn phí 10 GB, không tính phí băng thông tải xuống):
#   Cloudflare → R2 → tạo bucket (riêng tư) → "Manage R2 API Tokens" → quyền Object Read & Write cho đúng bucket đó
# Storage__ServiceUrl=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Storage__Region=auto
# Storage__Bucket=jpcenter
# Storage__AccessKey=<Access Key ID>
# Storage__SecretKey=<Secret Access Key>
# Storage__CreateBucket=false

# ---------- Outbox (sự kiện giữa các module) — mặc định đã hợp lý, thường không cần đổi ----------
# Outbox__Enabled=true
# Outbox__PollMilliseconds=5000
# Outbox__MaxAttempts=8
# Outbox__RetryBaseMilliseconds=10000

# ---------- Log (Seq — xem tại http://localhost:5341) ----------
Seq__Url=http://localhost:5341

# ---------- Webhook ngân hàng (đối soát VietQR — TC-10) ----------
# Khóa ký HMAC-SHA256 do ngân hàng / cổng thanh toán cung cấp. Bỏ trống = từ chối mọi webhook.
# Header: X-Signature: sha256=<hex HMAC-SHA256(body)>
Finance__BankWebhookSecret=
