# Sao chép thành .env.local nếu muốn đổi (không bắt buộc — mặc định đã dùng API thật).
#   api  : đăng nhập / phân quyền / duyệt cấp quyền gọi backend thật (chạy backend trước: xem backend/README.md)
#   mock : chạy toàn bộ bằng dữ liệu giả trong trình duyệt, không cần backend
VITE_API_MODE=api

# Backend mà Vite dev server chuyển tiếp /api tới
VITE_PROXY_TARGET=http://localhost:5080
