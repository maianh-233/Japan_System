  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "^5.5.1",
    "@tanstack/react-query": "^5.59.0",
    "antd": "^5.21.0",
    "dayjs": "^1.11.13",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "msw": "^2.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
